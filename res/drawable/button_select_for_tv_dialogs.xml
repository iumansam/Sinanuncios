<?xml version="1.0" encoding="utf-8"?>
<selector android:enterFadeDuration="150" android:exitFadeDuration="150"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/red100transparent" />
            <stroke android:width="2.0dip" android:color="@color/white" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/red500transparent" />
            <stroke android:width="2.0dip" android:color="@color/white" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
</selector>