<?xml version="1.0" encoding="utf-8"?>
<selector android:enterFadeDuration="100" android:exitFadeDuration="100"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimaryDark" />
            <stroke android:width="2.0dip" android:color="@color/white" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff9e0000" android:endColor="#ffe00000" android:angle="0.0" />
            <stroke android:width="2.0dip" android:color="@color/white" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff9e0000" android:endColor="#ffe00000" android:angle="0.0" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
</selector>