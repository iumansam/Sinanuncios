<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14.0dip" />
            <solid android:color="#ff3a3a3f" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18.0dip" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
            <item android:left="4.0dip" android:top="4.0dip" android:right="4.0dip" android:bottom="4.0dip">
                <shape android:shape="rectangle">
                    <corners android:radius="14.0dip" />
                    <solid android:color="#ff25252a" />
                    <stroke android:width="1.0dip" android:color="#36ffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14.0dip" />
            <solid android:color="#ff222226" />
            <stroke android:width="1.0dip" android:color="#22ffffff" />
        </shape>
    </item>
</selector>