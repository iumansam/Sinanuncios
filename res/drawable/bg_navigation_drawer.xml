<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff000000" android:endColor="#ff140000" android:angle="0.0" android:centerColor="#ff050000" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/bg_gradient_dither_noise" android:dither="true" android:tileMode="repeat" />
    </item>
    <item android:gravity="end">
        <shape android:shape="rectangle">
            <size android:width="1.0dip" />
            <solid android:color="@color/nav_drawer_stroke" />
        </shape>
    </item>
</layer-list>