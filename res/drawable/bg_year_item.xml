<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimaryDark" />
            <stroke android:width="2.0dip" android:color="#fffff1a8" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/red500transparent" />
            <stroke android:width="1.0dip" android:color="@color/colorPrimaryDark" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_red" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/grey1000" />
            <stroke android:width="1.0dip" android:color="@color/grey850" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
</selector>