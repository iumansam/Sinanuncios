<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white" />
                    <corners android:radius="12.0dip" />
                </shape>
            </item>
            <item android:left="4.0dip" android:top="4.0dip" android:right="4.0dip" android:bottom="4.0dip">
                <shape android:shape="rectangle">
                    <solid android:color="#ff1b1b1b" />
                    <stroke android:width="1.0dip" android:color="@color/colorPrimaryDark" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#ff221010" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ff151515" />
            <stroke android:width="1.0dip" android:color="@color/divider_color" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
</selector>