<?xml version="1.0" encoding="utf-8"?>
<selector android:enterFadeDuration="100" android:exitFadeDuration="100"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimaryDark" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white" />
                    <corners android:radius="12.0dip" />
                </shape>
            </item>
            <item android:left="4.0dip" android:top="4.0dip" android:right="4.0dip" android:bottom="4.0dip">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#ff9e0000" android:endColor="#ffe00000" android:angle="0.0" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff9e0000" android:endColor="#ffe00000" android:angle="0.0" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
</selector>