<?xml version="1.0" encoding="utf-8"?>
<selector android:enterFadeDuration="100" android:exitFadeDuration="100"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimaryDark" />
            <stroke android:width="2.0dip" android:color="@color/white" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#ff241010" />
            <stroke android:width="2.0dip" android:color="@color/white" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ff141414" />
            <stroke android:width="1.0dip" android:color="#ff5a1a1a" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
</selector>