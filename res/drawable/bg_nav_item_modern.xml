<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#12000000" android:endColor="#55300000" android:angle="0.0" android:centerColor="#22100000" />
            <stroke android:width="1.0dip" android:color="@color/nav_drawer_stroke" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#08000000" android:endColor="#33200000" android:angle="0.0" android:centerColor="#16100000" />
            <stroke android:width="1.0dip" android:color="#66ffffff" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_drawer_surface_pressed" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8.0dip" />
        </shape>
    </item>
</selector>